#!/bin/bash
set -euo pipefail
. "$(dirname "$0")/lib.sh"

log "preinstall start (queue $QUEUE, label $LABEL)"

[[ "$(sysctl -n hw.optional.arm64 2>/dev/null || echo 0)" == "1" ]] || die "this package requires a Mac with Apple Silicon"
macos_major="$(sw_vers -productVersion | cut -d. -f1)"
[[ "$macos_major" -ge "$MIN_MACOS_MAJOR" ]] || die "macOS $MIN_MACOS_MAJOR or later is required (found $(sw_vers -productVersion))"

mkdir -p "$STATE_DIR"
: > "$STATE_FILE"
state_set phase preinstall
state_set service_loaded_before 0
state_set binary_existed_before 0
state_set queue_existed_before 0
state_set queue_created_this_run 0
state_set updater_binary_existed_before 0
rm -rf "$BACKUP_DIR"
mkdir -p "$BACKUP_DIR"

if queue_exists; then
    existing_uri="$(queue_device_uri)"
    uri_is_our_service "$existing_uri" || die "a print queue named $QUEUE already exists with device URI '$existing_uri'; refusing to modify it. Remove or rename it and run the installer again."
    state_set queue_existed_before 1
    log "queue $QUEUE already exists with the expected device URI; it will be updated"
fi

if service_loaded; then
    state_set service_loaded_before 1
fi
if [[ -f "$ROOT$SERVICE_BINARY" ]]; then
    state_set binary_existed_before 1
    cp -p "$ROOT$SERVICE_BINARY" "$BACKUP_DIR/service"
    [[ -f "$ROOT$PLIST" ]] && cp -p "$ROOT$PLIST" "$BACKUP_DIR/plist"
fi

if [[ -f "$ROOT$UPDATER_BINARY" ]]; then
    state_set updater_binary_existed_before 1
    cp -p "$ROOT$UPDATER_BINARY" "$BACKUP_DIR/updater"
    [[ -f "$ROOT$UPDATER_PLIST" ]] && cp -p "$ROOT$UPDATER_PLIST" "$BACKUP_DIR/updater.plist"
fi

if service_loaded; then
    launchctl bootout "system/$LABEL" > /dev/null 2>&1 || die "could not stop the running service $LABEL"
    log "stopped running service for upgrade"
elif [[ -n "$(port_listener)" ]]; then
    die "TCP port $PORT is already in use by another process:
$(port_listener)
Stop it (for example a manually started tmt88v-service) and run the installer again."
fi

state_set phase preinstall-complete
log "preinstall complete"
exit 0
